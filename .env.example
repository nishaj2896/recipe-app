# Local development settings. scripts/dev.sh copies this file to .env on its
# first run and fills in a fresh signing key; .env is git-ignored.
# Other commands can read the same file: uv run --env-file .env <command>

# The Postgres from compose.yaml.
DATABASE_URL=postgresql+asyncpg://recipe_app:recipe_app@localhost:5433/recipe_app

# Signs "generate more" cursors. Any base64url key of at least 32 bytes.
# Make one with:
#   uv run python -c 'import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
CURSOR_ACTIVE_KID=dev
CURSOR_SIGNING_KEYS='{"dev": "REPLACE_ME"}'
