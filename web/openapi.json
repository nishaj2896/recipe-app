{
  "components": {
    "schemas": {
      "CatalogIngredient": {
        "properties": {
          "category": {
            "$ref": "#/components/schemas/CategoryRef"
          },
          "class": {
            "enum": ["A", "B", "S"],
            "title": "Class",
            "type": "string"
          },
          "diet": {
            "$ref": "#/components/schemas/Diet"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "anyOf": [
              {
                "enum": ["fresh", "pantry"],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kind"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "search_terms": {
            "items": {
              "type": "string"
            },
            "title": "Search Terms",
            "type": "array"
          }
        },
        "required": ["id", "name", "class", "kind", "category", "diet", "search_terms"],
        "title": "CatalogIngredient",
        "type": "object"
      },
      "CategoryRef": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": ["id", "name"],
        "title": "CategoryRef",
        "type": "object"
      },
      "Diet": {
        "enum": ["vegan", "vegetarian", "egg", "non_veg"],
        "title": "Diet",
        "type": "string"
      },
      "FieldError": {
        "properties": {
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": ["field", "message"],
        "title": "FieldError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["status"],
        "title": "Health",
        "type": "object"
      },
      "IgnoredIngredient": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "reason": {
            "$ref": "#/components/schemas/IgnoredReason"
          }
        },
        "required": ["id", "name", "reason"],
        "title": "IgnoredIngredient",
        "type": "object"
      },
      "IgnoredReason": {
        "enum": ["retired", "now_staple", "not_staple"],
        "title": "IgnoredReason",
        "type": "string"
      },
      "IngredientRef": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": ["id", "name"],
        "title": "IngredientRef",
        "type": "object"
      },
      "IngredientsResponse": {
        "properties": {
          "ingredients": {
            "items": {
              "$ref": "#/components/schemas/CatalogIngredient"
            },
            "title": "Ingredients",
            "type": "array"
          }
        },
        "required": ["ingredients"],
        "title": "IngredientsResponse",
        "type": "object"
      },
      "PlanAhead": {
        "description": "A hands-off wait of an hour or more that the times leave out (ADR-0009).",
        "properties": {
          "note": {
            "description": "Finishes \"Plan ahead: \", so it starts in lower case, such as \"soak overnight\".",
            "title": "Note",
            "type": "string"
          },
          "wait_minutes": {
            "title": "Wait Minutes",
            "type": "integer"
          }
        },
        "required": ["wait_minutes", "note"],
        "title": "PlanAhead",
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 problem details; every error response uses this body.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": ["title", "status"],
        "title": "Problem",
        "type": "object"
      },
      "RecipeCard": {
        "properties": {
          "assumed_staples": {
            "items": {
              "$ref": "#/components/schemas/IngredientRef"
            },
            "title": "Assumed Staples",
            "type": "array"
          },
          "cook_minutes": {
            "title": "Cook Minutes",
            "type": "integer"
          },
          "diet": {
            "$ref": "#/components/schemas/Diet"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "match_percentage": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Share of core weight matched; null on all-staples cards.",
            "title": "Match Percentage"
          },
          "matched_ingredients": {
            "items": {
              "$ref": "#/components/schemas/IngredientRef"
            },
            "title": "Matched Ingredients",
            "type": "array"
          },
          "missing_ingredients": {
            "items": {
              "$ref": "#/components/schemas/IngredientRef"
            },
            "title": "Missing Ingredients",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "plan_ahead": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PlanAhead"
              },
              {
                "type": "null"
              }
            ]
          },
          "prep_minutes": {
            "title": "Prep Minutes",
            "type": "integer"
          },
          "tier": {
            "$ref": "#/components/schemas/Tier"
          },
          "total_minutes": {
            "title": "Total Minutes",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "tier",
          "match_percentage",
          "matched_ingredients",
          "missing_ingredients",
          "assumed_staples",
          "prep_minutes",
          "cook_minutes",
          "total_minutes",
          "diet",
          "plan_ahead"
        ],
        "title": "RecipeCard",
        "type": "object"
      },
      "RecipeDetail": {
        "properties": {
          "cook_minutes": {
            "title": "Cook Minutes",
            "type": "integer"
          },
          "diet": {
            "$ref": "#/components/schemas/Diet"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "image": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RecipeImage"
              },
              {
                "type": "null"
              }
            ]
          },
          "ingredients": {
            "items": {
              "$ref": "#/components/schemas/RecipeIngredient"
            },
            "title": "Ingredients",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "plan_ahead": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PlanAhead"
              },
              {
                "type": "null"
              }
            ]
          },
          "prep_minutes": {
            "title": "Prep Minutes",
            "type": "integer"
          },
          "serves": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Servings the amounts are written for; null before a sync.",
            "title": "Serves"
          },
          "steps": {
            "items": {
              "type": "string"
            },
            "title": "Steps",
            "type": "array"
          },
          "total_minutes": {
            "title": "Total Minutes",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "prep_minutes",
          "cook_minutes",
          "total_minutes",
          "diet",
          "plan_ahead",
          "serves",
          "ingredients",
          "steps",
          "image"
        ],
        "title": "RecipeDetail",
        "type": "object"
      },
      "RecipeImage": {
        "properties": {
          "alt": {
            "title": "Alt",
            "type": "string"
          },
          "url": {
            "description": "A path on the web origin, versioned by content.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": ["url", "alt"],
        "title": "RecipeImage",
        "type": "object"
      },
      "RecipeIngredient": {
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "For the recipe's `serves`; null with `unit` when to taste.",
            "title": "Amount"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "unit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Unit"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["id", "name", "amount", "unit"],
        "title": "RecipeIngredient",
        "type": "object"
      },
      "SearchRequest": {
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "anyOf": [
              {
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cursor"
          },
          "diet": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Diet"
              },
              {
                "type": "null"
              }
            ]
          },
          "excluded_staples": {
            "default": [],
            "items": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            },
            "maxItems": 100,
            "title": "Excluded Staples",
            "type": "array",
            "uniqueItems": true
          },
          "hidden_recipe_ids": {
            "default": [],
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 200,
            "title": "Hidden Recipe Ids",
            "type": "array",
            "uniqueItems": true
          },
          "ingredient_ids": {
            "items": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Ingredient Ids",
            "type": "array",
            "uniqueItems": true
          },
          "limit": {
            "default": 20,
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "max_total_minutes": {
            "anyOf": [
              {
                "maximum": 600.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Total Minutes"
          }
        },
        "required": ["ingredient_ids"],
        "title": "SearchRequest",
        "type": "object"
      },
      "SearchResponse": {
        "properties": {
          "ignored_ingredients": {
            "items": {
              "$ref": "#/components/schemas/IgnoredIngredient"
            },
            "title": "Ignored Ingredients",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/RecipeCard"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": ["results", "next_cursor", "ignored_ingredients"],
        "title": "SearchResponse",
        "type": "object"
      },
      "StapleCategory": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "staples": {
            "items": {
              "$ref": "#/components/schemas/IngredientRef"
            },
            "title": "Staples",
            "type": "array"
          }
        },
        "required": ["id", "name", "staples"],
        "title": "StapleCategory",
        "type": "object"
      },
      "StapleKindGroup": {
        "properties": {
          "categories": {
            "items": {
              "$ref": "#/components/schemas/StapleCategory"
            },
            "title": "Categories",
            "type": "array"
          },
          "kind": {
            "enum": ["fresh", "pantry"],
            "title": "Kind",
            "type": "string"
          }
        },
        "required": ["kind", "categories"],
        "title": "StapleKindGroup",
        "type": "object"
      },
      "StaplesResponse": {
        "properties": {
          "groups": {
            "items": {
              "$ref": "#/components/schemas/StapleKindGroup"
            },
            "title": "Groups",
            "type": "array"
          }
        },
        "required": ["groups"],
        "title": "StaplesResponse",
        "type": "object"
      },
      "Tier": {
        "enum": ["scored", "all_staples"],
        "title": "Tier",
        "type": "string"
      },
      "Unit": {
        "enum": [
          "g",
          "kg",
          "ml",
          "l",
          "tsp",
          "tbsp",
          "cup",
          "small",
          "medium",
          "large",
          "small-head",
          "bunch",
          "piece",
          "clove",
          "sprig",
          "slice",
          "leaf",
          "pinch",
          "can"
        ],
        "title": "Unit",
        "type": "string"
      }
    }
  },
  "info": {
    "description": "Recipes you can cook from what's in your kitchen. Clients must ignore response fields they don't recognise.",
    "title": "Pantry to Plate",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/ingredients": {
      "get": {
        "description": "Every live ingredient for the picker. Send `If-None-Match` on every load.",
        "operationId": "list_ingredients_api_v1_ingredients_get",
        "parameters": [
          {
            "description": "The ETag from the last response; 304 if unchanged.",
            "in": "header",
            "name": "If-None-Match",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngredientsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "304": {
            "description": "Not Modified"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "List Ingredients",
        "tags": ["catalog"]
      }
    },
    "/api/v1/recipes/search": {
      "post": {
        "description": "One swipe deck. Follow `next_cursor`, unchanged, for the next deck.",
        "operationId": "search_recipes_api_v1_recipes_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Search Recipes",
        "tags": ["recipes"]
      }
    },
    "/api/v1/recipes/{recipe_id}": {
      "get": {
        "operationId": "get_recipe_api_v1_recipes__recipe_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "recipe_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Recipe Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecipeDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Get Recipe",
        "tags": ["recipes"]
      }
    },
    "/api/v1/staples": {
      "get": {
        "description": "Live staples by kind, then category, for the staples screen.",
        "operationId": "list_staples_api_v1_staples_get",
        "parameters": [
          {
            "description": "The ETag from the last response; 304 if unchanged.",
            "in": "header",
            "name": "If-None-Match",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaplesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "304": {
            "description": "Not Modified"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "List Staples",
        "tags": ["catalog"]
      }
    },
    "/healthz": {
      "get": {
        "description": "Liveness only: the process is up. Readiness comes in Task 5.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Healthz",
        "tags": ["ops"]
      }
    }
  }
}
